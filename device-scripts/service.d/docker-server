#!/system/bin/sh
# Magisk service.d 开机服务：自动拉起 Ubuntu 容器服务器（chroot 挂载 + dockerd + sshd）
# 由 magiskinit 在 late_start 阶段执行，父进程为 init，不随任何 adb 会话死亡。
sleep 45
UB=/data/ubuntu

mount --bind $UB $UB 2>/dev/null
mount --bind /dev $UB/dev 2>/dev/null
# Expose Android cpuset so containerd can resolve all process cgroup paths.
mount --bind /dev/cpuset $UB/dev/cpuset 2>/dev/null
mount --bind /proc $UB/proc 2>/dev/null
mount --bind /sys $UB/sys 2>/dev/null
mount -t tmpfs tmpfs $UB/sys/fs/cgroup 2>/dev/null
mkdir -p $UB/sys/fs/cgroup/cpu $UB/sys/fs/cgroup/cpuacct $UB/sys/fs/cgroup/memory \
         $UB/sys/fs/cgroup/devices $UB/sys/fs/cgroup/freezer $UB/sys/fs/cgroup/blkio
mount --bind /dev/cpuctl $UB/sys/fs/cgroup/cpu 2>/dev/null
mount --bind /acct $UB/sys/fs/cgroup/cpuacct 2>/dev/null
mount --bind /dev/memcg $UB/sys/fs/cgroup/memory 2>/dev/null
mount -t cgroup -o devices devices $UB/sys/fs/cgroup/devices 2>/dev/null
mount -t cgroup -o freezer freezer $UB/sys/fs/cgroup/freezer 2>/dev/null
mount -t cgroup -o blkio blkio $UB/sys/fs/cgroup/blkio 2>/dev/null

chroot $UB /bin/sh -c "PATH=/usr/bin:/bin; rm -f /var/run/docker.pid" 2>/dev/null
chroot $UB /bin/sh -c "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; nohup dockerd --storage-driver=vfs --iptables=false --ip6tables=false > /root/dockerd.log 2>&1 < /dev/null &"
sleep 12

mkdir -p $UB/run/sshd
chroot $UB /bin/bash -c "export PATH=/usr/bin:/bin; umask 022; test -f /etc/ssh/ssh_host_rsa_key || ssh-keygen -A >/dev/null 2>&1; /usr/sbin/sshd 2>/dev/null"
