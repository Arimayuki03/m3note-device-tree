+/*
+ * Android exposes one global, name-keyed interface table in init_net.proc_net.
+ * Container interfaces must not replace entries belonging to Android or each
+ * other. Notifications while moving a device out of init_net are delivered
+ * before dev_net() changes, so its final snapshot is still accounted for.
+ */
+static bool qtaguid_iface_in_init_net(const struct net_device *dev)
+{
+	return dev && net_eq(dev_net(dev), &init_net);
 }
 
